{
  "name": "Lead Capture to Google Sheets",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "new-lead",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "0885dbc6-86c7-40de-bb75-e5db6f7f82a7",
      "name": "Lead Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        250,
        300
      ],
      "webhookId": "931ae2d5-c832-4e45-8922-ea4fbb998836"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "6051a6a2-c5d9-4567-9b2c-1e4609d6c2de",
              "name": "name",
              "type": "string",
              "value": "={{ $json.name }}"
            },
            {
              "id": "fba2f141-24ad-4b34-8598-bc82e62ca108",
              "name": "email",
              "type": "string",
              "value": "={{ $json.email }}"
            },
            {
              "id": "e3edb2b5-3b67-44c3-8006-2037b7377910",
              "name": "source",
              "type": "string",
              "value": "website"
            },
            {
              "id": "09179b81-6801-44e9-b540-246583f809e3",
              "name": "created_at",
              "type": "string",
              "value": "={{ $now.toISO() }}"
            }
          ]
        },
        "options": {}
      },
      "id": "cedf7cb5-7d71-49bf-bb1b-b14b7f718ce2",
      "name": "Format Lead",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        470,
        300
      ]
    },
    {
      "parameters": {
        "resource": "sheetWithinDocument",
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "name": "={{ $json.name }}",
            "email": "={{ $json.email }}",
            "source": "={{ $json.source }}",
            "created_at": "={{ $json.created_at }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "6f5e7e14-1037-4673-a1c8-09ea57ef90a0",
      "name": "Save to Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        690,
        300
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "you@example.com",
        "subject": "=New lead: {{ $json.name }}",
        "emailType": "text",
        "message": "=Name: {{ $json.name }}\nEmail: {{ $json.email }}\nSource: {{ $json.source }}",
        "options": {}
      },
      "id": "f7a85570-67ff-4a9d-98cf-2474d259de4f",
      "name": "Notify by Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        910,
        300
      ]
    }
  ],
  "connections": {
    "Lead Webhook": {
      "main": [
        [
          {
            "node": "Format Lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Lead": {
      "main": [
        [
          {
            "node": "Save to Sheets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save to Sheets": {
      "main": [
        [
          {
            "node": "Notify by Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {
    "notes": "POST {name, email} -> Sheets row + email alert. Add Google + Gmail credentials."
  }
}