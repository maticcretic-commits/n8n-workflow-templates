          "__rl": true,
          "value": "gpt-4o-mini",
          "mode": "list"
        },
        "messages": {
          "values": [
            {
              "content": "Classify this email subject+snippet as URGENT or NORMAL. Reply with only one word."
            },
            {
              "content": "={{ $json.subject }} {{ $json.snippet }}"
            }
          ]
        },
        "options": {}
      },
      "id": "6459b317-7080-40e0-b342-9bd4ee0df640",
