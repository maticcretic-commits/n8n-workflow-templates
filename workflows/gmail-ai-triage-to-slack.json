      "typeVersion": 1.8,
      "position": [
        470,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "version": 2
          },
          "conditions": [
            {
              "id": "4526b130-77eb-49e5-a4b2-1ac6dd40b2c7",
              "leftValue": "={{ $json.message.content }}",
              "rightValue": "URGENT",
              "operator": {
                "type": "string",
                "operation": "contains"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "58131cbb-ce06-46cc-916b-8ad9cb9cd54f",
